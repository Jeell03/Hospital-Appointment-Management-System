
@model List<Hospital.Controllers.Post> 
    @* Receive the API posts. *@

@{
    ViewData["Title"] = "API Posts"; // Set the page title.
}

<h1>Posts from JSONPlaceholder API</h1> @* Display the page heading. *@

@if (ViewBag.Error != null) @* Check whether the API request failed. *@
{
    <div class="alert alert-danger">@ViewBag.Error</div> @* Display the API error. *@
}

<table class="table table-bordered table-striped"> @* Display API data in a table. *@
    <thead>
        <tr>
            <th>Post ID</th>
            <th>Post Title</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var post in Model) @* Iterate over the retrieved posts. *@
        {
            <tr>
                <td>@post.Id</td> @* Display the post ID. *@
                <td>@post.Title</td> @* Display the post title. *@
            </tr>
        }
    </tbody>
</table>

<a asp-controller="Doctors" asp-action="Index" class="btn btn-primary">Back to Doctors</a> @* Return to the doctors page. *@
